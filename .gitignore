# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# runtime uploads
/public/uploads/
# ໄຟລ໌ແນບຄັງຄວາມຮູ້ — ນອກ webroot ໂດຍເຈດຕະນາ (ຕັ້ງ KB_UPLOAD_DIR ຕອນ deploy)
/private-uploads/

# ຂໍ້ມູນສຳຮອງ DB (ຢ່າຂຶ້ນ git)
backups/
